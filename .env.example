# Fermi Operations — Environment Variables Example
# Copy this file to .env and fill in the values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# App URL — REQUIRED for OAuth + password-reset emails to redirect correctly.
# Set this to your production domain in Vercel environment variables.
VITE_APP_URL=https://fermi-ops.vercel.app

# Slack Integration (Optional)
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Basecamp Integration (Optional)
VITE_BASECAMP_ACCOUNT_ID=your_account_id
VITE_BASECAMP_TOKEN=your_personal_access_token
